{
  "name": "dsh-cache-warmer",
  "version": "0.1.4",
  "private": true,
  "description": "Estimated cache time and opt-in, cost-aware prompt-cache warming for DeepSeek Harness sessions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoggu/dsh-cache-warmer.git"
  },
  "homepage": "https://github.com/yoggu/dsh-cache-warmer#readme",
  "bugs": { "url": "https://github.com/yoggu/dsh-cache-warmer/issues" },
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": ["lib", "client.js", "cordis.patch.yml", "README.md", "icon.svg", "locale"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.2 || ^0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.4.3"
  },
  "engines": { "node": ">=22.19.0" },
  "scripts": { "test": "node --test lib/*.test.js tests/*.test.js" }
}
